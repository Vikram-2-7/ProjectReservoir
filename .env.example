# BrookStream.Ai Configuration
# Copy this file to .env and update the values

# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-change-this-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3

# OpenWeatherMap API
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Email Configuration (for alerts and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/1

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/brookstream.log

# Security Configuration
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Weather API Configuration
WEATHER_CACHE_TIMEOUT=600
WEATHER_API_RATE_LIMIT=60

# Alert Configuration
ALERT_EMAIL_ENABLED=True
ALERT_SMS_ENABLED=False
ALERT_WEBHOOK_ENABLED=False

# Data Processing Configuration
ML_MODEL_RETRAIN_INTERVAL=24  # hours
DATA_RETENTION_DAYS=365

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_UPLOAD_TYPES=.csv,.xlsx,.json
